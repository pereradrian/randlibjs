{
  "name": "randlibjs",
  "version": "1.0.23",
  "description": "Random number generation for JavaScript: numpy.random and scipy.stats style distributions, reproducible bit generators (xoshiro128**, PCG32, MT19937), exact samplers, Generator objects. Zero dependencies, browser and Node.",
  "type": "module",
  "main": "./dist/randlib.cjs",
  "module": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./dist/randlib.cjs",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/randlib.min.js",
  "jsdelivr": "dist/randlib.min.js",
  "files": [
    "index.js",
    "src",
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src index.js test scripts",
    "build": "node scripts/build.mjs",
    "docs": "jsdoc -c docs/input/jsdoc.json",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pereradrian/randlibjs.git"
  },
  "keywords": [
    "random",
    "rng",
    "prng",
    "numpy",
    "scipy",
    "distributions",
    "statistics",
    "probability",
    "sampling",
    "monte-carlo",
    "seed",
    "xoshiro",
    "pcg",
    "mersenne-twister",
    "stochastic"
  ],
  "author": "Adrián Muñoz Perera, https://pereradrian.github.io",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/pereradrian/randlibjs/issues"
  },
  "homepage": "https://pereradrian.github.io/randlibjs/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "vitest": "^5.1.1"
  }
}
