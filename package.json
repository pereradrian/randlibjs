{
  "name": "randlibjs",
  "version": "2.2.3",
  "description": "Seedable random numbers and statistics for JavaScript: exact samplers for 75+ probability distributions, scipy-style pdf, cdf, quantiles and fitting, statistical tests, copulas, quasi-Monte Carlo, numpy-compatible streams. Zero dependencies.",
  "type": "module",
  "main": "./dist/randlib.cjs",
  "module": "./index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/randlib.cjs"
      },
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "dist/randlib.min.js",
  "jsdelivr": "dist/randlib.min.js",
  "files": [
    "index.js",
    "src",
    "dist",
    "!dist/randlib.js",
    "types",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src index.js test scripts",
    "build": "node scripts/build.mjs && node scripts/build-types.mjs",
    "docs": "jsdoc -c docs/input/jsdoc.json",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "build:types": "node scripts/build-types.mjs",
    "typecheck": "npm run build:types && tsc -p tsconfig.check.json",
    "size": "size-limit",
    "check:package": "publint --strict && attw --pack .",
    "check:claims": "node scripts/check-claims.mjs",
    "logo": "node scripts/make-logo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randlibjs/randlibjs.git"
  },
  "keywords": [
    "random",
    "rng",
    "prng",
    "numpy",
    "scipy",
    "distributions",
    "statistics",
    "probability",
    "sampling",
    "monte-carlo",
    "seed",
    "xoshiro",
    "pcg",
    "mersenne-twister",
    "stochastic",
    "copula",
    "hypothesis-testing",
    "maximum-likelihood",
    "quasi-monte-carlo",
    "typescript"
  ],
  "author": "Adrián Muñoz Perera, https://pereradrian.github.io",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/randlibjs/randlibjs/issues"
  },
  "homepage": "https://randlibjs.github.io/randlibjs/",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "publint": "^0.3.25",
    "size-limit": "^14.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "types": "./types/index.d.ts"
}
